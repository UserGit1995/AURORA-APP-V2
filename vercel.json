{
  "rewrites": [
    {
      "source": "/installa",
      "destination": "/installa/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/prodotto/:id",
      "destination": "/api/seo?type=product&id=:id"
    },
    {
      "source": "/forniture",
      "destination": "/api/seo?type=hub"
    },
    {
      "source": "/forniture/:slug",
      "destination": "/api/seo?type=landing&slug=:slug"
    },
    {
      "source": "/recensione",
      "destination": "/api/seo?type=review"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/aurora-v2.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Aurora.apk\""
        }
      ]
    },
    {
      "source": "/aurora.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
